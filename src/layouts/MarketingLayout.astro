---
import "@fontsource/instrument-serif/latin-400.css"
import "@fontsource/instrument-serif/latin-400-italic.css"
import "@fontsource-variable/instrument-sans/wght.css"
import "@fontsource-variable/jetbrains-mono/wght.css"
import "../styles/tokens.css"
import "../styles/marketing.css"
import SiteHeader from "../components/site/SiteHeader.astro"
import SiteFooter from "../components/site/SiteFooter.astro"
import { alternateFor, type Locale } from "../i18n/routes"

interface Props {
  title: string
  description: string
  lang?: Locale
}
const { title, description, lang = "en" } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const alternate = new URL(alternateFor(lang, Astro.url.pathname), Astro.site)
const htmlLang = lang === "en" ? "en" : "zh-CN"

// scripts/og.ts names a card after the route it belongs to, so the image is
// derived here rather than passed in: "/" is home, "/miao/" is miao, and the
// locale picks the suffix. Adding a marketing page means adding a card.
const route = Astro.url.pathname.replace(/^\/zh(?=\/|$)/, "").replace(/\//g, "")
const ogImage = new URL(`/og/${route === "" ? "home" : route}-${lang}.png`, Astro.site)
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang} href={canonical} />
    <link rel="alternate" hreflang={lang === "en" ? "zh-CN" : "en"} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={lang === "en" ? canonical : alternate} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0d0d0c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "zh_CN"} />
    <meta property="og:site_name" content="mtty.dev" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Mirror Starlight's stored preference so a reader who picks a theme in
      // the docs keeps it on the marketing pages. Runs before paint.
      try {
        const stored = localStorage.getItem("starlight-theme")
        const preferred = window.matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark"
        document.documentElement.dataset.theme =
          stored === "light" || stored === "dark" ? stored : preferred
      } catch {
        document.documentElement.dataset.theme = "dark"
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === "en" ? "Skip to content" : "跳到正文"}</a>
    <SiteHeader lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
