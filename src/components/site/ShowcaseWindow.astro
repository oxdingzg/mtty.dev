---
import MiaoMark from './MiaoMark.astro'
import MttyMark from './MttyMark.astro'
import ProductMedia from './ProductMedia.astro'
interface Slide { src: string; label: string; alt: string }
interface Props { product: 'miao' | 'mtty'; kind: string; lang: string; slides: Slide[]; embedded?: boolean }
const { product, kind, lang, slides, embedded = false } = Astro.props
const zh = lang === 'zh'
---
<figure class="showcase-window" data-embedded={embedded ? '' : undefined} data-showcase data-interval={product === 'miao' ? 6500 : 7500} aria-label={`${product} ${zh ? '功能展示' : 'feature showcase'}`}>
  <figcaption class="window-header">
    <span class="window-brand">
      {product === 'miao' ? <MiaoMark size={15} /> : <MttyMark size={15} />}<b>{product}</b>
    </span>
    <span class="window-kind">{kind}</span>
    <button class="playback" data-playback hidden aria-label={zh ? '暂停自动轮播' : 'Pause slideshow'} data-pause-label={zh ? '暂停自动轮播' : 'Pause slideshow'} data-play-label={zh ? '播放自动轮播' : 'Play slideshow'}><span aria-hidden="true">Ⅱ</span></button>
  </figcaption>
  <div class="window-stage">
    {slides.map((slide, index) => (
      <a class="window-slide" data-slide data-active={index === 0 ? '' : undefined} aria-hidden={index > 0 ? 'true' : undefined} tabindex={index > 0 ? -1 : undefined} href={slide.src} target="_blank" rel="noopener noreferrer" aria-label={`${slide.label} · ${zh ? '查看原图' : 'View full image'}`}>
        <ProductMedia src={slide.src} alt={slide.alt} eager={index === 0 && product === 'miao'} />
      </a>
    ))}
  </div>
  <div class="window-footer">
    <span class="feature-label" data-feature>{slides[0].label}</span>
    <div class="slide-controls" data-controls hidden>
      <button data-prev aria-label={zh ? '上一张' : 'Previous image'}>‹</button>
      {slides.map((slide, index) => <button class="slide-dot" data-dot={index} aria-label={slide.label} aria-current={index === 0 ? 'true' : undefined}><span></span></button>)}
      <button data-next aria-label={zh ? '下一张' : 'Next image'}>›</button>
    </div>
  </div>
</figure>

<style>
  .showcase-window { margin: 0; min-width: 0; padding: 0 5px 5px; border: 1px solid var(--border-strong); border-radius: 14px; background: var(--surface); box-shadow: 0 24px 44px -22px rgb(0 0 0 / .35), 0 3px 10px -4px rgb(0 0 0 / .12); }
  .window-header { display: flex; align-items: center; gap: 10px; height: 36px; margin: 0; padding: 0 8px; font-size: .72rem; }
  .window-brand { display: inline-flex; align-items: center; gap: 6px; color: var(--fg); font-family: var(--font-mono); }
  .window-kind { color: var(--fg-muted); }
  .playback { margin-left: auto; }
  .window-stage { position: relative; aspect-ratio: var(--showcase-aspect-ratio, 8 / 5); overflow: hidden; border-radius: 9px; background: #111312; }
  .window-slide { position: absolute; inset: 0; display: block; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 450ms ease, visibility 450ms; cursor: zoom-in; }
  .window-slide[data-active] { opacity: 1; visibility: visible; pointer-events: auto; }
  .window-slide :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .window-footer { display: flex; align-items: center; gap: 8px; height: 28px; padding: 0 8px; }
  .feature-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--fg-muted); font-size: .65rem; }
  .slide-controls { display: flex; align-items: center; gap: 3px; margin-left: auto; }
  button { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 24px; height: 24px; padding: 0; border: 0; border-radius: 5px; background: transparent; color: var(--fg-muted); font-size: 18px; cursor: pointer; }
  button:hover { background: var(--border); color: var(--fg); }
  button:focus-visible, .window-slide:focus-visible { outline: 2px solid var(--mtty-accent); outline-offset: -2px; }
  .playback { font-size: 11px; }
  .slide-dot { width: 16px; }
  .slide-dot span { width: 5px; height: 5px; border-radius: 50%; background: var(--fg-faint); opacity: .4; transition: width 200ms, opacity 200ms; }
  .slide-dot[aria-current] span { width: 12px; border-radius: 4px; opacity: 1; background: var(--mtty-ink); }
  .showcase-window[data-embedded] { position: relative; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  [data-embedded] .window-header { position: absolute; bottom: 0; right: 4px; z-index: 1; height: 32px; padding: 0; }
  [data-embedded] .window-brand, [data-embedded] .window-kind { display: none; }
  [data-embedded] .window-footer { height: 32px; padding-right: 34px; }
  [hidden] { display: none !important; }
  @media (prefers-reduced-motion: reduce) { .window-slide, .slide-dot span { transition: none; } }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-showcase]')) {
    const slides = [...root.querySelectorAll<HTMLAnchorElement>('[data-slide]')]
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')]
    const playback = root.querySelector<HTMLButtonElement>('[data-playback]')!
    const feature = root.querySelector<HTMLElement>('[data-feature]')!
    const reduce = matchMedia('(prefers-reduced-motion: reduce)')
    let index = 0
    let paused = reduce.matches
    let visible = false
    let hovered = false
    let timer: ReturnType<typeof setTimeout> | undefined
    const schedule = () => {
      clearTimeout(timer)
      if (paused || !visible || hovered || document.hidden || root.contains(document.activeElement)) return
      timer = setTimeout(() => { show(index + 1); schedule() }, Number(root.dataset.interval))
    }
    const show = (next: number) => {
      index = (next + slides.length) % slides.length
      slides.forEach((slide, i) => {
        slide.toggleAttribute('data-active', i === index)
        slide.setAttribute('aria-hidden', String(i !== index))
        slide.tabIndex = i === index ? 0 : -1
        if (i === index) slide.querySelector('img')!.loading = 'eager'
      })
      dots.forEach((dot, i) => i === index ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'))
      feature.textContent = dots[index].getAttribute('aria-label')
    }
    const updatePlayback = () => {
      playback.setAttribute('aria-label', (paused ? playback.dataset.playLabel : playback.dataset.pauseLabel)!)
      playback.querySelector('span')!.textContent = paused ? '▶' : 'Ⅱ'
    }
    root.querySelector<HTMLElement>('[data-controls]')!.hidden = false
    playback.hidden = false
    updatePlayback()
    playback.addEventListener('click', () => { paused = !paused; updatePlayback(); schedule() })
    root.querySelector('[data-prev]')!.addEventListener('click', () => { show(index - 1); schedule() })
    root.querySelector('[data-next]')!.addEventListener('click', () => { show(index + 1); schedule() })
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); schedule() }))
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return
      event.preventDefault(); show(index + (event.key === 'ArrowRight' ? 1 : -1)); schedule()
    })
    root.addEventListener('mouseenter', () => { hovered = true; schedule() })
    root.addEventListener('mouseleave', () => { hovered = false; schedule() })
    root.addEventListener('focusin', schedule)
    root.addEventListener('focusout', () => setTimeout(schedule, 0))
    document.addEventListener('visibilitychange', schedule)
    reduce.addEventListener('change', () => { paused = reduce.matches; updatePlayback(); schedule() })
    const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; schedule() }, { threshold: .3 })
    observer.observe(root)
  }
</script>
