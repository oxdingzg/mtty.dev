---
// mtty's mark: the app icon from mtty/scripts/make-icon.py, redrawn as
// vectors so it scales. Same proportions as the script — rounded tile at 0.22
// radius, a Nord8 chevron, a Nord13 cursor block — on a 32-unit grid.
interface Props {
  size?: number
}
const { size = 32 } = Astro.props
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="7" fill="var(--mtty-tile)" />
  <path
    d="M9.25 11.5 15.25 16 9.25 20.5"
    fill="none"
    stroke="var(--mtty-accent)"
    stroke-width="2.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <rect x="17.25" y="18.75" width="6.25" height="2" fill="var(--mtty-warm)" />
</svg>
