---
import manifest from '../../data/media.json'

interface Asset {
  type: string
  width: number
  height: number
  small?: string
  poster?: string
}
interface Props {
  src: string
  alt: string
  eager?: boolean
  sizes?: string
}
const { src, alt, eager = false, sizes = '(max-width: 900px) 100vw, 50vw' } = Astro.props
const assets: Record<string, Asset> = manifest
const asset = assets[src]
if (!asset) throw new Error(`Unknown product media: ${src}`)
const zh = Astro.url.pathname.startsWith('/zh/')
---

{asset.type === 'video' ? (
  <div class="product-media video-frame" style={`aspect-ratio: ${asset.width} / ${asset.height}`}>
    <video
      data-product-video
      data-poster={asset.poster}
      width={asset.width}
      height={asset.height}
      aria-label={alt}
      preload="none"
      muted
      loop
      playsinline
      controls
    >
      <source data-src={src} type="video/mp4" />
    </video>
    <button class="manual-play" data-media-play hidden>▶ {zh ? '播放演示' : 'Play demo'}</button>
    <noscript><a href={src}><img src={asset.poster} width={asset.width} height={asset.height} alt={alt} loading="lazy" /></a></noscript>
  </div>
) : (
  <img
    class="product-media"
    src={src}
    srcset={`${asset.small} 640w, ${src} ${asset.width}w`}
    sizes={sizes}
    width={asset.width}
    height={asset.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
)}

<style>
  .product-media { display: block; width: 100%; height: auto; background: #1c1c1c; }
  .video-frame { position: relative; }
  video { display: block; width: 100%; height: 100%; }
  noscript img { display: block; width: 100%; height: auto; }
  noscript a { position: absolute; inset: 0; }
  .manual-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 10px 16px; border: 1px solid #aaa; border-radius: 8px; background: #202020; color: #fff; font: inherit; font-size: .85rem; cursor: pointer; }
  .manual-play:focus-visible { outline: 2px solid var(--mtty-accent); outline-offset: 3px; }
  [hidden] { display: none !important; }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)')
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
  for (const video of document.querySelectorAll<HTMLVideoElement>('[data-product-video]')) {
    let visible = false
    let manuallyPaused = false
    let loaded = false
    const button = video.parentElement!.querySelector<HTMLButtonElement>('[data-media-play]')!
    const load = () => {
      if (loaded) return
      loaded = true
      const source = video.querySelector('source')!
      source.src = source.dataset.src!
      video.load()
      video.controls = true
      button.hidden = true
    }
    const update = () => {
      const manual = reduce.matches || connection?.saveData
      if (!loaded) {
        button.hidden = !manual
        video.controls = !manual
      }
      if (!visible || document.hidden || reduce.matches || connection?.saveData || manuallyPaused) {
        video.pause()
        return
      }
      load()
      // Autoplay can be disallowed by the browser; native controls still work.
      void video.play().catch(() => {})
    }
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      if (visible) {
        video.poster = video.dataset.poster!
      }
      update()
    }, { threshold: .2 })
    observer.observe(video)
    button.addEventListener('click', () => {
      load()
      void video.play().catch(() => {})
    })
    video.addEventListener('pause', () => {
      if (visible && !document.hidden && !reduce.matches && !connection?.saveData) manuallyPaused = true
    })
    video.addEventListener('play', () => { manuallyPaused = false })
    document.addEventListener('visibilitychange', update)
    reduce.addEventListener('change', update)
  }
</script>
