---
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang?: Locale
  /**
   * The marketing page this footer sits under: "" for the home page, otherwise
   * the product slug. miao's fork notice belongs on miao's own page — the home
   * page is the umbrella page for both products, not a miao page.
   */
  product?: string
}
const { lang = "en", product = "" } = Astro.props

const prefix = prefixFor(lang)
const en = lang === "en"
const year = new Date().getFullYear()

const columns = [
  {
    head: "miao",
    links: [
      { href: `${prefix}/miao`, label: en ? "Overview" : "概览" },
      { href: `${prefix}/docs/miao/guide/`, label: en ? "Guide" : "使用指南" },
      {
        href: `${prefix}/docs/miao/miao-vs-opencode/`,
        label: en ? "Compared with opencode" : "与 opencode 对比",
      },
      { href: "https://github.com/oxdingzg/miao/releases", label: en ? "Releases" : "版本发布" },
      { href: "https://github.com/oxdingzg/miao", label: "GitHub" },
    ],
  },
  {
    head: "mtty",
    links: [
      { href: `${prefix}/mtty`, label: en ? "Overview" : "概览" },
      { href: `${prefix}/docs/mtty/`, label: en ? "Documentation" : "文档" },
      {
        href: "https://github.com/oxdingzg/mtty/releases",
        label: en ? "Downloads" : "下载",
      },
      { href: "https://github.com/oxdingzg/mtty", label: "GitHub" },
    ],
  },
  {
    head: en ? "legal" : "法律",
    links: [
      { href: `${prefix}/docs/about/privacy/`, label: en ? "Privacy" : "隐私" },
      { href: `${prefix}/docs/about/license/`, label: en ? "License" : "许可" },
    ],
  },
]
---

<footer class="site-footer">
  <div class="inner">
    <div class="sign">
      <p class="mark"><span class="chev">&gt;</span> mtty.dev</p>
      <p class="motto">
        {en ? "An agent and a terminal, both open source." : "一个代理，一个终端，都是开源的。"}
      </p>
    </div>
    {
      columns.map((column) => (
        <div class="col">
          <p class="head">{column.head}</p>
          {column.links.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      ))
    }
    <div class="contact">
      <p class="head">{en ? "contact" : "联系"}</p>
      <a href="mailto:contact@mtty.dev">contact@mtty.dev</a>
      {
        product === "miao" && (
          <p class="fork">
            {en ? (
              <>
                miao is an independent fork of{" "}
                <a href="https://github.com/anomalyco/opencode">opencode</a>, which is MIT
                licensed. This site is not affiliated with or endorsed by that project.
              </>
            ) : (
              <>
                miao 是 <a href="https://github.com/anomalyco/opencode">opencode</a>{" "}
                的独立分支，后者以 MIT 协议授权。本站与该上游项目无隶属关系，也未获其背书。
              </>
            )}
          </p>
        )
      }
    </div>
  </div>
  <div class="inner">
    <div class="baseline">
      <span>© {year} mtty.dev</span>
      <span>miao · MIT &nbsp;/&nbsp; mtty · Apache-2.0</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 140px;
    border-top: 1px solid var(--border);
    background: var(--bg-tint);
    padding: 56px 0 28px;
    font-size: 0.9rem;
  }

  .inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 1.2fr 0.85fr 0.85fr 0.75fr 1.3fr;
    gap: 40px;
  }

  .mark {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--fg);
  }

  .chev {
    color: var(--mtty-ink);
  }

  .motto {
    margin: 10px 0 0;
    color: var(--fg-faint);
    max-width: 24ch;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .head {
    margin: 0 0 4px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-faint);
  }

  a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--fg);
  }

  /* miao's fork notice, shown on miao's own page only: fine print under the
     contact line, divided like the baseline row. */
  .fork {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--fg-faint);
    line-height: 1.6;
  }

  .fork a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .baseline {
    grid-column: 1 / -1;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  /* Five columns need room; below that, the link columns pair up and the brand
     and contact blocks take a full row each. */
  @media (max-width: 1040px) {
    .inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }

    .sign {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }

    .contact {
      grid-column: 1 / -1;
    }
  }
</style>
