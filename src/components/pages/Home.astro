---
// The home page, in both languages. The copy for each language sits side by
// side so a change to one is visibly a change to the other.
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import InstallCommand from "../site/InstallCommand.astro"
import MiaoMark from "../site/MiaoMark.astro"
import MttyMark from "../site/MttyMark.astro"
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const prefix = prefixFor(lang)

const RELEASES = "https://github.com/oxdingzg/miao-term/releases/latest"

const copy = {
  en: {
    title: "mtty.dev — miao, an AI coding agent, and mtty, an AI-native terminal and editor",
    description:
      "miao is an open-source AI coding agent for the terminal: your models, steerable long tasks, visible cost. mtty is an AI-native terminal and editor for local and remote work, written in Rust.",
    kicker: "Two open-source tools for the terminal",
    h1a: "An agent that does the work.",
    h1b: "A terminal that keeps watch.",
    miaoBlurb:
      "Reads a repository, edits code, runs commands and checks its own work — with the models you choose and a running tally of what each turn costs.",
    mttyBlurb:
      "An AI-native terminal and editor in Rust: terminals, files, remote hosts and agents in one window — and it knows when an agent is working, waiting on you, or done.",
    installHead: "Install miao",
    installMeta: "macOS · Linux · Windows",
    downloadHead: "Get mtty",
    download: "Download the preview",
    downloadMeta: "macOS · Linux · Windows · preview",
    copyLabel: "Copy command",
    shotMtty: "mtty with a full-height session sidebar of three tabs, the details panel, and a coloured git log in the active pane.",
    shotMiao: "miao, having listed every place in packages/core that spawns a subprocess, with its input box below.",
    capMtty: "mtty, showing its own git history",
    capMiao: "miao, answering a question about its own code",
    productsLabel: "the products",
    productsH: "Use either one. They are separate projects.",
    miaoKind: "AI coding agent",
    miaoH: "Your models. Your workflow. Less wasted context.",
    miaoPoints: [
      ["Steer a running task", "Add a requirement mid-task. It is saved first, then folded in at the next safe turn boundary."],
      ["Delegate with its own context", "Hand scoped work to a subagent; sessions can find and message each other."],
      ["See what every turn costs", "Tokens, estimated cost, time to first token and prompt-cache hits, per turn."],
      ["Keep the record", "Sessions are durable: reopen, fork and export them instead of losing a window."],
    ],
    miaoMeta: "TypeScript · Rust accelerators · MIT",
    miaoMore: "Explore miao",
    mttyKind: "Terminal · editor · agents",
    mttyH: "Terminal, editor and agents in one native window.",
    mttyPoints: [
      ["Rendered on the GPU", "A glyph-grid renderer on wgpu and glyphon; the hot path takes no locks and allocates nothing per frame."],
      ["A workspace, not just a window", "Tabs, recursive splits, ⌘K Open Quickly, a details panel, a reader and editor; an editor pane is on the way."],
      ["Aware of agents", "Pane badges, notifications, a sleep guard and a prompt queue driven by agent state."],
      ["Remote hosts like local folders", "A host library, keys, SFTP, port forwarding, jump hosts and snippets over your own OpenSSH."],
    ],
    mttyMeta: "Rust · Apache-2.0 · pre-release",
    mttyMore: "Explore mtty",
    togetherLabel: "better together",
    togetherH: "Run four agents. Read none of their windows.",
    togetherLede:
      "Inside an mtty pane, miao reports its state over the terminal's control plane. mtty badges the pane, raises a notification when an agent needs you, keeps the machine awake while one is working, and sends your queued prompt the moment it goes idle.",
    togetherFine:
      "Neither needs the other. Outside mtty the report is a no-op; with no agent reporting, mtty is simply a terminal. mtty also ships state hooks for other agent CLIs.",
    states: [
      ["api", "processing", "Working through the todo list"],
      ["web", "awaiting", "Asking permission to run a command"],
      ["docs", "idle", "Done — your queued prompt goes next"],
      ["migrate", "error", "The provider returned an error"],
    ],
    illus: "Illustration of the four states mtty understands",
    flow: ["miao", "agent state", "mtty pane"],
    shotsLabel: "in pictures",
    shotsH: "Terminals, editor and agents in one window.",
    shots: [
      ["/shots/mtty-workspace.png", "Tabs that report their agent", "Each tab is badged idle, processing or awaiting as the agent inside reports its state."],
      ["/shots/mtty-states.gif", "Agent state, live", "The badge and the Agent panel track the pane through the four states in real time."],
      ["/shots/mtty-editor.png", "Editor and live preview", "Open a Markdown file and its preview follows your typing; Mermaid renders in the pane."],
    ],
    honestLabel: "status",
    honestH: "Early, moving fast, and plain about it.",
    honest: [
      ["Pre-1.0", "Both projects release often and change between versions. Release notes live on GitHub."],
      ["Docs from the source", "The miao documentation here is synced from its repository, and every synced page names the commit it came from."],
      ["Claims with caveats", "Benchmarks say what they measure. Features that are opt-in or experimental say so."],
    ],
    endH: "Start with one command.",
    docs: "Read the docs",
  },
  zh: {
    title: "mtty.dev — AI 编程代理 miao 与 AI 原生终端编辑器 mtty",
    description:
      "miao 是在终端里运行的开源 AI 编程代理：模型由你选，长任务可中途调整，花费清清楚楚。mtty 是用 Rust 编写的 AI 原生终端与编辑器，本地与远程同样顺手。",
    kicker: "两个面向终端的开源工具",
    h1a: "一个替你干活的代理，",
    h1b: "一个替你盯着的终端。",
    miaoBlurb: "读仓库、改代码、跑命令、验证结果 —— 模型由你选，每一轮花了多少一目了然。",
    mttyBlurb: "用 Rust 编写的 AI 原生终端与编辑器：终端、文件、远程主机和代理同在一个窗口——它还知道代理正在干活、在等你确认，还是已经做完。",
    installHead: "安装 miao",
    installMeta: "macOS · Linux · Windows",
    downloadHead: "获取 mtty",
    download: "下载预览版",
    downloadMeta: "macOS · Linux · Windows · 预览版",
    copyLabel: "复制命令",
    shotMtty: "mtty 的全高会话侧栏里有三个标签，右侧是详情面板，活动窗格里是一份带颜色的 git 日志。",
    shotMiao: "miao 列出了 packages/core 中所有启动子进程的位置，下方是输入框。",
    capMtty: "mtty，展示自己的提交历史",
    capMiao: "miao，回答关于自身代码的问题",
    productsLabel: "两个产品",
    productsH: "任选其一，二者是独立的项目。",
    miaoKind: "AI 编程代理",
    miaoH: "模型由你选，工作持续推进，少浪费上下文。",
    miaoPoints: [
      ["运行中也能补充要求", "任务进行时追加约束：先持久化保存，再在下一个安全的轮次边界并入。"],
      ["委派给独立上下文", "把范围明确的工作交给子代理；会话之间可以相互发现并发消息。"],
      ["每一轮花了多少", "逐轮 token、估算费用、首 token 延迟与提示缓存命中。"],
      ["工作记录留得住", "会话持久保存：可重新打开、分叉、导出，不随窗口消失。"],
    ],
    miaoMeta: "TypeScript · Rust 加速 · MIT",
    miaoMore: "了解 miao",
    mttyKind: "终端 · 编辑器 · 代理",
    mttyH: "终端、编辑器与代理，同在一个原生窗口。",
    mttyPoints: [
      ["GPU 渲染", "基于 wgpu 与 glyphon 的字形网格渲染；热路径不加锁、每帧零分配。"],
      ["是工作台，不只是窗口", "标签、递归分屏、⌘K 快速打开、详情面板、阅读器与编辑器；编辑器窗格即将到来。"],
      ["懂得代理", "窗格徽章、系统通知、防休眠与提示队列，都由代理状态驱动。"],
      ["远程主机像本地目录", "主机库、密钥、SFTP、端口转发、跳板机与命令片段，经由你自己的 OpenSSH。"],
    ],
    mttyMeta: "Rust · Apache-2.0 · 预发布",
    mttyMore: "了解 mtty",
    togetherLabel: "配合使用",
    togetherH: "同时跑四个代理，不用盯着任何一个窗口。",
    togetherLede:
      "在 mtty 的窗格里，miao 通过终端的控制面上报自己的状态。mtty 据此给窗格加上徽章，在代理需要你时弹出通知，在它工作时阻止电脑休眠，并在它空闲的那一刻发出你排队的提示。",
    togetherFine:
      "二者互不依赖。离开 mtty，上报就是空操作；没有代理上报时，mtty 就只是一个终端。mtty 也为其他代理 CLI 提供状态钩子。",
    states: [
      ["api", "processing", "正在推进待办清单"],
      ["web", "awaiting", "请求执行命令的权限"],
      ["docs", "idle", "已完成 —— 下一条排队提示即将发出"],
      ["migrate", "error", "模型服务返回了错误"],
    ],
    illus: "示意：mtty 能识别的四种代理状态",
    flow: ["miao", "代理状态", "mtty 窗格"],
    shotsLabel: "看图",
    shotsH: "终端、编辑器与代理，同在一个窗口。",
    shots: [
      ["/shots/mtty-workspace.png", "会上报代理状态的标签", "标签里的代理上报状态后，标签会标注 idle、processing 或 awaiting。"],
      ["/shots/mtty-editor.png", "编辑器与实时预览", "打开 Markdown 文件，预览随输入更新；Mermaid 直接在窗格中渲染。"],
      ["/shots/mtty-splits.png", "递归分屏", "git 日志与运行中的服务并排；重启后布局自动恢复。"],
    ],
    honestLabel: "现状",
    honestH: "还很早期，迭代很快，话说在明处。",
    honest: [
      ["1.0 之前", "两个项目都发布频繁，版本之间会有变化。发布说明在 GitHub 上。"],
      ["文档出自源码", "本站的 miao 文档从其仓库同步而来，每一篇同步页面都注明来源提交。"],
      ["说法带着边界", "基准测试写明测的是什么；可选或实验性的功能会直说。"],
    ],
    endH: "从一条命令开始。",
    docs: "阅读文档",
  },
}[lang]
---

<MarketingLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="lattice" aria-hidden="true"></div>
    <div class="glow g1" aria-hidden="true"></div>
    <div class="glow g2" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="label rise"><b>{copy.kicker}</b></p>
        <h1 class="display h1 rise" style="--i:1">
          <span class="hl">{copy.h1a}</span>
          <em class="hl accent">{copy.h1b}</em>
        </h1>

        <div class="picks rise" style="--i:2">
          <div class="pick">
            <p class="pick-head">
              <MiaoMark size={20} />
              <b>miao</b>
              <span class="pick-kind">{copy.miaoKind}</span>
              <span class="pick-meta">{copy.installMeta}</span>
            </p>
            <p class="pick-blurb">{copy.miaoBlurb}</p>
            <InstallCommand id="install-hero" label={copy.copyLabel} />
          </div>
          <div class="pick">
            <p class="pick-head">
              <MttyMark size={20} />
              <b>mtty</b>
              <span class="pick-kind">{copy.mttyKind}</span>
              <span class="pick-meta">{copy.downloadMeta}</span>
            </p>
            <p class="pick-blurb">{copy.mttyBlurb}</p>
            <a class="btn dl" href={RELEASES}>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
                ><path
                  d="M8 2v8.5M4.5 7 8 10.5 11.5 7M3 13.5h10"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
              {copy.download}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <div class="hero-shots rise" style="--i:3">
        <figure class="shot s-miao">
          <img src="/shots/miao.png" width="1199" height="1150" alt={copy.shotMiao} />
          <figcaption><span class="ink-miao">●</span> {copy.capMiao}</figcaption>
        </figure>
        <figure class="shot s-mtty">
          <img
            src="/shots/mtty.png"
            width="1910"
            height="920"
            alt={copy.shotMtty}
            fetchpriority="high"
          />
          <div class="reflection" aria-hidden="true">
            <img src="/shots/mtty.png" width="1910" height="920" alt="" />
          </div>
          <figcaption><span class="ink-mtty">●</span> {copy.capMtty}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>01</b> {copy.productsLabel}</p>
      <h2 class="display h2">{copy.productsH}</h2>
    </div>
    <div class="duo">
      <a class="card c-miao" href={`${prefix}/miao`}>
        <div class="card-top">
          <MiaoMark size={40} />
          <div>
            <span class="card-name">miao</span>
            <span class="card-kind">{copy.miaoKind}</span>
          </div>
        </div>
        <h3 class="display h3">{copy.miaoH}</h3>
        <dl class="points">
          {
            copy.miaoPoints.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))
          }
        </dl>
        <div class="card-foot">
          <span class="card-meta">{copy.miaoMeta}</span>
          <span class="more">{copy.miaoMore} <span class="arrow">→</span></span>
        </div>
      </a>
      <a class="card c-mtty" href={`${prefix}/mtty`}>
        <div class="card-top">
          <MttyMark size={40} />
          <div>
            <span class="card-name">mtty</span>
            <span class="card-kind">{copy.mttyKind}</span>
          </div>
        </div>
        <h3 class="display h3">{copy.mttyH}</h3>
        <dl class="points">
          {
            copy.mttyPoints.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))
          }
        </dl>
        <div class="card-foot">
          <span class="card-meta">{copy.mttyMeta}</span>
          <span class="more">{copy.mttyMore} <span class="arrow">→</span></span>
        </div>
      </a>
    </div>
  </section>

  <section class="wrap section together" data-reveal>
    <div class="together-copy">
      <p class="label"><b>02</b> {copy.togetherLabel}</p>
      <h2 class="display h2">{copy.togetherH}</h2>
      <p class="lede">{copy.togetherLede}</p>
      <p class="fine">{copy.togetherFine}</p>
    </div>
    <div class="board panel" role="img" aria-label={copy.illus}>
      <div class="board-bar" aria-hidden="true">
        <MttyMark size={16} />
        <span>mtty</span>
      </div>
      <ul class="panes" aria-hidden="true">
        {
          copy.states.map(([name, state, note]) => (
            <li data-state={state}>
              <span class="badge" />
              <span class="pane-name">{name}</span>
              <span class="pane-state">{state}</span>
              <span class="pane-note">{note}</span>
            </li>
          ))
        }
      </ul>
      <div class="wire" aria-hidden="true">
        <span class="node n-miao">{copy.flow[0]}</span>
        <span class="line"><span class="pulse"></span></span>
        <span class="node">{copy.flow[1]}</span>
        <span class="line"><span class="pulse"></span></span>
        <span class="node n-mtty">{copy.flow[2]}</span>
      </div>
      <code class="board-cmd" aria-hidden="true"
        >mtty-cli state miao --state awaiting --pane $MTTY_PANE_ID</code
      >
    </div>
  </section>

  <section class="wrap section shots" data-reveal>
    <div class="section-head">
      <p class="label"><b>03</b> {copy.shotsLabel}</p>
      <h2 class="display h2">{copy.shotsH}</h2>
    </div>
    <div class="shotgrid">
      {
        copy.shots.map(([src, head, body]) => (
          <figure class="scard">
            <img src={src} width="1100" height="720" loading="lazy" alt={body} />
            <figcaption>
              <b>{head}</b>
              <span>{body}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>04</b> {copy.honestLabel}</p>
      <h2 class="display h2">{copy.honestH}</h2>
    </div>
    <ol class="honest">
      {
        copy.honest.map(([head, body], index) => (
          <li>
            <span class="n">0{index + 1}</span>
            <h3>{head}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section end" data-reveal>
    <h2 class="display h2">{copy.endH}</h2>
    <InstallCommand id="install-end" label={copy.copyLabel} />
    <div class="actions">
      <a class="btn" href={`${prefix}/docs/`}>{copy.docs} <span class="arrow">→</span></a>
      <a class="btn" href={RELEASES}>{copy.download} <span class="arrow">→</span></a>
    </div>
  </section>
</MarketingLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: 56px;
  }

  .g1 {
    width: 720px;
    height: 520px;
    left: -180px;
    top: -200px;
    background: var(--miao-1);
  }

  .g2 {
    width: 680px;
    height: 520px;
    right: -220px;
    top: 380px;
    background: var(--mtty-accent);
  }

  /* Copy and actions on the left, the two real captures on the right: the
     first screen says what each tool is, how to get it, and what it looks
     like. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: 56px;
    align-items: center;
    padding-bottom: 8px;
  }

  .h1 {
    margin-top: 4px;
    font-size: clamp(2.1rem, 3.1vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
  }

  .h1 .hl {
    display: block;
  }

  :lang(zh-CN) .h1 {
    font-size: clamp(1.9rem, 2.9vw, 2.7rem);
    line-height: 1.28;
  }

  .picks {
    display: grid;
    gap: 28px;
    margin-top: 36px;
  }

  .pick {
    display: grid;
    gap: 10px;
    min-width: 0;
    padding-top: 18px;
    border-top: 1px solid var(--border-strong);
  }

  .pick-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0;
    font-size: 0.92rem;
  }

  .pick-head b {
    font-family: var(--font-mono);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .pick-kind {
    color: var(--fg-muted);
  }

  .pick-meta {
    margin-left: auto;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .pick-blurb {
    margin: 0 0 4px;
    color: var(--fg-muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  /* Same height as the install command, so the two actions match. */
  .dl {
    width: 100%;
    height: 56px;
    justify-content: flex-start;
    background: var(--surface);
  }

  .dl .arrow {
    margin-left: auto;
  }

  /* The two captures at one scale: miao's window (1199 px wide, 62.8% of
     mtty's 1910) stands at the top right, in front and shown whole, its
     caption above it; mtty's wide window lies behind it across the bottom,
     mirrored below as a fading reflection. Margins in % are of the width,
     so the composition holds at every size. */
  .hero-shots {
    display: flow-root;
    min-width: 0;
  }

  .s-miao {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column-reverse;
    width: 62.8%;
    margin-left: auto;
  }

  .s-miao figcaption {
    margin-top: 0;
    margin-bottom: 12px;
  }

  .s-mtty {
    position: relative;
    z-index: 1;
    margin-top: -16%;
  }

  /* The same capture flipped under itself and faded out: the floor the two
     windows stand on. Only a band of it shows (16% of the width, about a
     third of the image), so it never pushes the page down by a whole image.
     The mask is in the image's own coordinates, before the flip: opaque at
     its bottom edge, which the flip puts right under the capture. */
  .reflection {
    position: relative;
    height: 0;
    padding-bottom: 14%;
    margin-top: 6px;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .shot .reflection img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transform: scaleY(-1);
    box-shadow: none;
    opacity: 0.22;
    mask-image: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 28%);
    -webkit-mask-image: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 28%);
  }

  .s-mtty > img,
  .s-miao > img {
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.85), 0 0 0 1px var(--border-strong);
  }

  :root[data-theme="light"] .s-mtty > img,
  :root[data-theme="light"] .s-miao > img {
    box-shadow: 0 34px 64px -30px rgb(40 30 10 / 0.45), 0 0 0 1px var(--border-strong);
  }

  .s-miao figcaption {
    text-align: right;
  }

  .s-mtty figcaption {
    text-align: center;
  }

  /* --- Products --- */

  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 36px;
    overflow: hidden;
    border: 1px solid var(--border);
