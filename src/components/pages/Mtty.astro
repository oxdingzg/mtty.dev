---

<MarketingLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="lattice" aria-hidden="true"></div>
    <div class="glow g1" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="label mtty rise"><MttyMark size={18} /><b>mtty</b> {copy.kind}</p>
        <h1 class="display h1 rise" style="--i:1">
          <span class="hl">{copy.h1a}</span>
          <em class="hl accent mtty">{copy.h1b}</em>
        </h1>
        <p class="lede rise" style="--i:2">{copy.lede}</p>
        <p class="fine naming rise" style="--i:2" set:html={copy.naming} />
        <div class="actions rise" style="--i:3">
          <a class="btn solid" href={RELEASES}>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M8 2v8.5M4.5 7 8 10.5 11.5 7M3 13.5h10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            {copy.download}
          </a>
          <a class="btn" href={REPO}>{copy.build} <span class="arrow">↗</span></a>
        </div>
        <ul class="pkgs rise" style="--i:3">
          {
            copy.pkgs.map(([os, formats]) => (
              <li>
                <b>{os}</b>
                <span>{formats}</span>
              </li>
            ))
          }
        </ul>
        <div class="callout preview rise" style="--i:3">
          <span class="pip" aria-hidden="true"></span>
          <p set:html={copy.preview} />
        </div>
      </div>
      <figure class="shot hero-shot rise" style="--i:4">
        <ProductMedia src="/shots/mtty.webp" alt={copy.shot} eager />
        <figcaption>{copy.cap}</figcaption>
      </figure>
    </div>
    <div class="wrap">
      <dl class="glance rise" style="--i:5" aria-label={copy.glanceLabel}>
        {
          copy.glance.map(([head, body]) => (
            <div>
              <dt>{head}</dt>
              <dd>{body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>00</b> {copy.pillarsLabel}</p>
      <h2 class="display h2">{copy.pillarsH}</h2>
    </div>
    <ul class="ws pillars">
      {
        copy.pillars.map(([head, from, today, next]) => (
          <li>
            <div class="ws-top">
              <h3>{head}</h3>
              <kbd>{from}</kbd>
            </div>
            <p><strong>{copy.pillarsToday}.</strong> {today}</p>
            <p><strong>{copy.pillarsNext}.</strong> {next}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section engine" data-reveal>
    <div class="engine-copy">
      <p class="label"><b>01</b> {copy.engineLabel}</p>
      <h2 class="display h2">{copy.engineH}</h2>
      <p class="lede">{copy.engineBody}</p>
      <p class="hot">
        <span class="path" aria-hidden="true"
          ><span>pty</span><i>→</i><span>vt</span><i>→</i><span>grid</span><i>→</i><span
            >renderer</span
          ></span
        >
        {copy.hot}
      </p>
    </div>
    <div class="stack">
      {
        copy.layers.map(([tier, crate, role]) => (
          <div class="layer" data-tier={tier}>
            <span class="tier">{tier}</span>
            <code class="crate">{crate}</code>
            <span class="role">{role}</span>
          </div>
        ))
      }
      <div class="beside">
        <span class="tier">{copy.besideLabel}</span>
        {copy.beside.map((name) => <code>miao-term-{name}</code>)}
      </div>
    </div>
  </section>

  <section class="wrap section perf" data-reveal>
    <div class="section-head">
      <p class="label"><b>02</b> {copy.perfLabel}</p>
      <h2 class="display h2">{copy.perfH}</h2>
      <p class="lede">{copy.perfBody}</p>
    </div>
    <div class="meters">
      {
        copy.perf.map(([metric, budget, baseline]) => (
          <div class="meter">
            <p class="metric">{metric}</p>
            <p class="baseline">{baseline}</p>
            <p class="budget">
              <span>{copy.perfHead[1]}</span> {budget}
            </p>
          </div>
        ))
      }
    </div>
    <p class="fine note">{copy.perfFine}</p>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>03</b> {copy.wsLabel}</p>
      <h2 class="display h2">{copy.wsH}</h2>
    </div>
    <ul class="ws">
      {
        copy.ws.map(([head, body, hint]) => (
          <li>
            <div class="ws-top">
              <h3>{head}</h3>
              <kbd>{hint}</kbd>
            </div>
            <p>{body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="screens" class="wrap section screens" data-reveal>
    <div class="section-head">
      <p class="label"><b>04</b> {copy.screensLabel}</p>
      <h2 class="display h2">{copy.screensH}</h2>
      <p class="lede">{copy.screensBody}</p>
    </div>
    <div class="gallery">
      {
        copy.screens.map(([src, head, body]) => (
          <figure class="gcard">
            <ProductMedia src={src} alt={body} />
            <figcaption>
              <b>{head}</b>
              <span>{body}</span>
              <a class="media-original" href={src} target="_blank" rel="noopener noreferrer">{lang === "zh" ? "放大查看" : "View full size"} ↗</a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="wrap section agents" data-reveal>
    <div class="agents-copy">
      <p class="label"><b>05</b> {copy.agentLabel}</p>
      <h2 class="display h2">{copy.agentH}</h2>
      <p class="lede">{copy.agentBody}</p>
    </div>
    <div class="agents-side">
      <div class="statebar" aria-hidden="true">
        <span data-state="idle">idle</span>
        <span data-state="processing">processing</span>
        <span data-state="awaiting">awaiting</span>
        <span data-state="error">error</span>
      </div>
      <dl class="agent-points">
        {
          copy.agentPoints.map(([term, detail, key]) => (
            <div>
              <dt>
                {term} {key && <kbd>{key}</kbd>}
              </dt>
              <dd>{detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap section mtp" data-reveal>
    <div>
      <p class="label"><b>06</b> {copy.mtpLabel}</p>
      <h2 class="display h2">{copy.mtpH}</h2>
      <p class="lede">{copy.mtpBody}</p>
      <p class="fine">{copy.mtpFine}</p>
    </div>
    <pre class="codeblock mtty"><code><span class="p">$ </span>mtty-cli pane list
<span class="p">$ </span>mtty-cli pane run --pane ID --data "cargo test"
<span class="p">$ </span>mtty-cli events --topic agent.state
<span class="p">$ </span>mtty-cli wait --since 42
<span class="p">$ </span>mtty-cli view ./README.md
<span class="p">$ </span>mtty-cli file read --path /etc/hosts   <span class="c"># ≤ 2 MB</span></code></pre>
  </section>

  <section class="wrap section keys" data-reveal>
    <div class="section-head">
      <p class="label"><b>07</b> {copy.keysLabel}</p>
      <h2 class="display h3">{copy.keysH}</h2>
    </div>
    <dl class="keygrid">
      {
        copy.keys.map(([key, action]) => (
          <div>
            <dt><kbd>{key}</kbd></dt>
            <dd>{action}</dd>
          </div>
        ))
      }
    </dl>
    <p class="fine note">{copy.keysFine}</p>
  </section>

  <section class="wrap section end" data-reveal>
    <MttyMark size={44} />
    <h2 class="display h2">{copy.endH}</h2>
    <div class="actions">
      <a class="btn solid" href={RELEASES}>{copy.download} <span class="arrow">→</span></a>
      <a class="btn" href={`${prefix}/docs/mtty/`}>{copy.docs} <span class="arrow">→</span></a>
    </div>
    <p class="fine src">{copy.srcLabel}</p>
    <pre class="codeblock mtty"><code><span class="p">$ </span>git clone https://github.com/oxdingzg/miao-term.git && cd miao-term
<span class="p">$ </span>cargo run --release -p mtty-app</code></pre>
  </section>
</MarketingLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: 88px;
  }

  .g1 {
    width: 760px;
    height: 560px;
    right: -200px;
    top: -240px;
    background: var(--mtty-accent);
  }

  /* Two columns, as on the miao page: what it is on the left, what it looks
     like on the right, so both land in the first screen. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  /* Sized so "An AI-native terminal and editor," holds one line in its column
     — 10.96em at the widest, against a 587px column at 1440px. */
  .h1 {
    font-size: clamp(2.2rem, 3.55vw, 3.2rem);
  }

  @media (min-width: 961px) {
    .h1 .hl {
      white-space: nowrap;
    }
  }

  .h1 .hl {
    display: block;
  }

  :lang(zh-CN) .h1 {
    font-size: clamp(1.9rem, 3.55vw, 3.2rem);
    line-height: 1.22;
  }

  .hero-copy .lede {
    margin-top: 30px;
  }

  .naming {
    margin: 14px 0 0;
  }

  .hero-copy .actions {
    margin-top: 28px;
  }

  .pkgs {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg-faint);
  }

  .pkgs b {
    color: var(--fg-muted);
    font-weight: 500;
    margin-right: 6px;
  }

  /* The same lifted frame the miao hero uses, so the two product pages read as
     one site. */
  .hero-shot :global(img) {
    box-shadow:
      0 60px 120px -40px rgb(0 0 0 / 0.95),
      0 0 0 1px var(--border-strong);
  }

  :root[data-theme="light"] .hero-shot :global(img) {
    box-shadow:
      0 40px 80px -36px rgb(40 30 10 / 0.45),
      0 0 0 1px var(--border-strong);
  }

  .preview {
    margin-top: 20px;
  }

  .preview p {
    margin: 0;
  }

  /* Three short capability lines under the columns: the first screen should say
     what the product is, not only what it looks like. */
  .glance {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    /* Kept close to the columns above: together they are the first screen, and
       the whole hero has to clear a 900px viewport. */
    margin: 16px 0 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--border);
  }

  .glance div {
    padding: 12px 20px 14px;
    background: var(--surface);
  }

  .glance dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--mtty-ink);
  }

  .glance dd {
    margin: 5px 0 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* --- Engine --- */

  .engine {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .engine-copy {
    display: grid;
    gap: 22px;
  }

  .engine-copy .label {
    margin: 0;
  }

  .hot {
    margin: 6px 0 0;
    display: grid;
    gap: 10px;
    color: var(--fg);
    font-weight: 550;
  }

  .path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
  }

  .path span {
    padding: 3px 9px;
    border: 1px solid color-mix(in srgb, var(--mtty-ink) 45%, transparent);
    border-radius: 4px;
    color: var(--mtty-ink);
  }

  .path i {
    font-style: normal;
    color: var(--fg-faint);
  }

  .stack {
    display: grid;
    gap: 8px;
  }

  .layer {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 4px 16px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .layer[data-tier="host"] {
    margin-right: 0;
  }

  .layer[data-tier="render"] {
    margin-inline: 16px;
  }

  .layer[data-tier="core"] {
    margin-inline: 32px;
    border-color: color-mix(in srgb, var(--mtty-ink) 50%, transparent);
    background: color-mix(in srgb, var(--mtty-ink) 7%, var(--surface));
  }

  .tier {
    grid-row: span 2;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding-top: 3px;
  }

  .layer[data-tier="core"] .tier {
    color: var(--mtty-ink);
  }

  .crate {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .role {
    color: var(--fg-muted);
    font-size: 0.88rem;
  }

  .beside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 14px 20px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .beside .tier {
    margin-right: 6px;
    padding: 0;
  }

  .beside code {
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--surface-raised);
    font-size: 0.76rem;
    color: var(--fg-muted);
  }

  /* --- Perf --- */

  .meters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border);
  }

  .meter {
    padding: 26px 24px 26px 0;
  }

  .meter + .meter {
    padding-left: 24px;
    border-left: 1px solid var(--border);
  }

  .meter p {
    margin: 0;
  }

  .metric {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  .baseline {
    margin-top: 14px !important;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 1;
    color: var(--mtty-ink);
  }

  .budget {
    margin-top: 14px !important;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--fg-faint);
  }

  .budget span {
    margin-right: 6px;
  }

  .note {
    margin-top: 22px;
    max-width: 80ch;
  }

  /* --- Workspace --- */

  .ws {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--border);
  }

  .ws li {
    padding: 24px 22px 26px;
    background: var(--surface);
    transition: background 160ms ease;
  }

  .ws li:hover {
    background: var(--surface-raised);
  }

  .ws-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .ws h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .ws kbd {
    font-size: 0.68rem;
    color: var(--fg-faint);
  }

  .ws p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  .ws.pillars {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ws.pillars p + p {
    margin-top: 10px;
  }

  .ws.pillars .ws-top {
    flex-wrap: wrap;
  }

  .ws.pillars kbd {
    white-space: normal;
  }

  .ws.pillars strong {
    color: var(--fg);
    font-weight: 600;
  }

  /* --- Agents --- */

  .agents {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .agents-copy {
    display: grid;
    gap: 22px;
  }

  .agents-copy .label {
    margin: 0;
  }

  .statebar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin-bottom: 18px;
  }

  .statebar span {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--c);
  }

  .statebar span::before {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
  }

  [data-state="processing"] {
    --c: #88c0d0;
  }

  [data-state="awaiting"] {
    --c: #ebcb8b;
  }

  [data-state="idle"] {
    --c: #a3be8c;
  }

  [data-state="error"] {
    --c: #d08770;
  }

  :root[data-theme="light"] [data-state="processing"] {
    --c: #3f7f92;
  }

  :root[data-theme="light"] [data-state="awaiting"] {
    --c: #9a6b0c;
  }

  :root[data-theme="light"] [data-state="idle"] {
    --c: #4f7a35;
  }

  :root[data-theme="light"] [data-state="error"] {
    --c: #b24a3a;
  }

  .agent-points {
    margin: 0;
  }

  .agent-points div {
    padding: 18px 0;
    border-top: 1px solid var(--border);
  }

  .agent-points dt {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .agent-points dd {
    margin: 6px 0 0;
    color: var(--fg-muted);
  }

  /* --- MTP --- */

  .mtp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .mtp .lede {
    margin-top: 22px;
  }

  .mtp .fine {
    margin-top: 14px;
  }

  .mtp .codeblock {
    padding: 26px 28px;
  }

  /* --- Keys --- */

  .keys .section-head {
    margin-bottom: 28px;
  }

  .keygrid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 40px;
  }

  .keygrid div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }

  .keygrid dd {
    margin: 0;
    color: var(--fg-muted);
  }

  .end {
    display: grid;
    justify-items: center;
    gap: 26px;
    text-align: center;
  }

  .end .src {
    margin: 10px 0 -12px;
    font-family: var(--font-mono);
  }

  .end .codeblock {
    max-width: 100%;
    text-align: left;
  }

  /* --- Screens gallery --- */

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .gcard {
    display: flex;
    flex-direction: column;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color 200ms ease, transform 200ms var(--ease);
  }

  .gcard:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .gcard:first-child {
    grid-column: 1 / -1;
  }

  .gcard :global(.product-media) {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--border);
    background: var(--mtty-tile);
  }

  .gcard figcaption {
    display: grid;
    gap: 6px;
    padding: 18px 20px 20px;
  }

  .gcard b {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
  }

  .gcard span {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }

    .gcard:first-child {
      grid-column: auto;
    }
  }

  @media (max-width: 1080px) {
    .ws {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ws.pillars {
      grid-template-columns: minmax(0, 1fr);
    }

    .meters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meter:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .meter:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 960px) {
    .hero-grid,
    .engine,
    .agents,
    .mtp {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .glance {
      grid-template-columns: minmax(0, 1fr);
    }

    .keygrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 52px;
    }

    .hero-grid {
      gap: 28px;
    }

    .glance {
      margin-top: 36px;
    }

    .ws {
      grid-template-columns: minmax(0, 1fr);
    }

    .layer[data-tier="render"] {
      margin-inline: 8px;
    }

    .layer[data-tier="core"] {
      margin-inline: 16px;
    }

    .layer {
      grid-template-columns: minmax(0, 1fr);
      padding: 16px;
    }

    .tier {
      grid-row: auto;
    }

    .statebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .keygrid {
      grid-template-columns: minmax(0, 1fr);
    }

    .mtp .codeblock,
    .end .codeblock {
      font-size: 0.74rem;
      padding: 18px;
    }

    .meter {
      padding-right: 12px;
    }

    .meter + .meter {
      padding-left: 12px;
    }

    .meter:nth-child(odd) {
      padding-left: 0;
    }

    .metric {
      min-height: 2.9em;
    }
  }
</style>
