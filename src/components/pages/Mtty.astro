---
// The mtty product page, in both languages. Claims follow the miao-term README,
// docs/PERFORMANCE.md and docs/INSTALL.md. The application ships as `mtty`
// from the miao-term repository.
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import MttyMark from "../site/MttyMark.astro"
import { prefixFor, type Locale } from "../../i18n/routes"

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const prefix = prefixFor(lang)

const REPO = "https://github.com/oxdingzg/miao-term"
const RELEASES = `${REPO}/releases/latest`

const copy = {
  en: {
    title: "mtty — an AI-native terminal and editor, written in Rust",
    description:
      "mtty is an AI-native terminal and editor for local and remote work, written in Rust: GPU-rendered terminals, remote hosts, files and your AI coding agents in one fast native window.",
    kind: "Terminal · editor · agents",
    h1a: "An AI-native terminal and editor,",
    h1b: "for local and remote work.",
    lede: "Terminals, files, remote hosts and your AI coding agents in one fast, native window — the same tabs and splits for all of them. Written in Rust, GPU-rendered, held to a performance gate. No account, no forced cloud: mtty hosts the agents you choose and never calls a model itself.",
    naming: "The application ships as <code>mtty</code> (called <code>miaotty</code> up to v0.0.5); the source lives in <code>miao-term</code>.",
    download: "Download the preview",
    build: "Build from source",
    pkgs: [
      ["macOS", "Apple silicon · Intel"],
      ["Linux", ".deb · AppImage · tar"],
      ["Windows", "MSI · zip"],
    ],
    shot: "mtty with three session tabs, a session sidebar, and a coloured git log in the active pane.",
    cap: "Three session tabs, the session sidebar, and the repository's own git log",
    preview: "<strong>Pre-release.</strong> The API is not stable yet. macOS is the primary platform; Windows and Linux are built, tested and checked on real desktops. Apple notarization and Windows MSI signing are still pending.",
    pillarsLabel: "three pillars",
    pillarsH: "One window for the terminal, the editor and the agents.",
    pillarsToday: "Today",
    pillarsNext: "Next",
    pillars: [
      ["Terminal and remote", "Absorbs Termius and PuTTY", "GPU-rendered terminal, tabs and splits, session restore. Host library, keys, SFTP and FTP, port forwarding, jump hosts, snippets and broadcast input, over your own OpenSSH.", "Serial, Telnet and raw TCP sessions, .ppk keys; a Rust-native SSH stack is under consideration."],
      ["Editor", "A first-class editor, not a side feature", "A built-in viewer and editor with Markdown and Mermaid preview. The editing core — rope buffer, multi-cursor, undo, search — is done and gated at 100 MB.", "An editor pane beside your terminals: tree-sitter highlighting, LSP, large files at full speed."],
      ["Agent workspace", "Absorbs Superset, AI-native", "State from Claude Code, Codex, OpenCode and miao; badges and notifications when one needs you; a prompt queue; a git worktree per task with diff review; a scriptable control plane.", "Agents' edits reviewed inline as undoable diffs, an ACP client, and selections, diagnostics or terminal output sent to an agent in one step."],
    ],
    engineLabel: "engine first",
    engineH: "The engine and the app are separate on purpose.",
    engineBody: "Dependencies point inward only — host, then renderer, then core — and the core has no windowing or GPU code, so it can be embedded in something else. The app is the engine's first consumer, not its owner.",
    hot: "The hot path takes no locks and allocates nothing per frame.",
    layers: [
      ["host", "miao-term-widget", "winit + wgpu render loop; composites egui chrome in the same frame"],
      ["render", "miao-term-render", "wgpu + glyphon glyph grid; quad and image pipelines"],
      ["core", "miao-term-core", "PTY, VT parsing, grid and scrollback, selection, search, OSC, input encoding"],
    ],
    beside: ["graphics", "config", "mtp", "ui"],
    besideLabel: "alongside",
    perfLabel: "measured",
    perfH: "Budgets enforced in CI.",
    perfBody: "Every metric has an absolute budget with generous headroom: an order-of-magnitude regression fails the build, runner jitter does not.",
    perfHead: ["Metric", "Budget", "Baseline"],
    perf: [
      ["VT parse throughput", "≥ 25 MB/s", "73 MB/s"],
      ["Screen snapshot, 30 rows", "≤ 2 ms", "0.012 ms"],
      ["Row build per frame", "≤ 4 ms", "0.12 ms"],
      ["Palette rank, 10k entries", "≤ 100 ms", "2.0 ms"],
    ],
    perfFine: "Baselines are release builds on an M-series Mac. Frame time and key-to-glyph latency need a real window and GPU, so they are measured by hand rather than gated.",
    wsLabel: "the workspace",
    wsH: "More than a window with a prompt in it.",
    ws: [
      ["Tabs and splits", "A recursive split tree with draggable dividers. Tabs can be marked and grouped, and both survive a restart.", "⌘D  ⇧⌘D"],
      ["Open Quickly", "One palette over tabs, agents, snippets, hosts, files in the current folder, recent files and commands.", "⌘K"],
      ["Details panel", "Info, Agent, Outline, Git, Files, Ports and Queue, beside the terminal.", "⌥⌘D"],
      ["Reader and editor", "Line numbers, an opt-in minimal vim mode, Edit in Tab with your own editor, and CommonMark with built-in Mermaid subsets.", "⌘-open"],
      ["Inline graphics", "Sixel, Kitty and iTerm2 images drawn in the grid; they scroll with the content and clip to the pane.", "on by default"],
      ["Real terminal behaviour", "VT via alacritty_terminal, CJK layout with system font fallback, find with highlighting, the kitty keyboard protocol.", "⌘F"],
      ["Brings your config", "Imports ghostty and alacritty settings on first run. zsh integration arrives through a ZDOTDIR shim; your dotfiles are never modified.", "config.toml"],
      ["Remote files over ssh", "View and edit a remote file through the pane's ssh ControlMaster connection, with a zero-install terminfo bootstrap.", "ssh"],
    ],
    agentLabel: "built for agents",
    agentH: "It knows what the agent in each pane is doing.",
    agentBody: "Agents report idle, processing, awaiting or error. mtty turns that into a badge on the tab, a system notification when one needs you, a sleep guard while one is working, and a prompt queue that sends the next message once the pane goes idle.",
    agentPoints: [
      ["miao", "Reports its state from a built-in integration. Nothing to wire up."],
      ["Other agent CLIs", "mtty detects them, installs a state hook script and copies the snippet for you to add. Your agent's config is never edited for you."],
      ["Composer", "A multi-line prompt editor that sends to the focused pane.", "⌘⇧E"],
    ],
    mtpLabel: "scriptable",
    mtpH: "A control plane other programs can drive.",
    mtpBody: "MTP speaks newline-delimited JSON over a per-user socket created with owner-only permissions — a named pipe on Windows. Every response carries a state revision; clients can block until it moves, or subscribe to an event stream instead of polling.",
    mtpFine: "Serving it over TCP requires a token, and a capability allowlist can restrict what is accepted. The control plane runs commands in your shell, so treat the token as a secret.",
    keysLabel: "keyboard",
    keysH: "Shortcuts",
    keys: [
      ["⌘T", "New tab"],
      ["⌘D / ⇧⌘D", "Split right / down"],
      ["⌘K", "Open Quickly"],
      ["⌘F", "Find"],
      ["⌥⌘D", "Details panel"],
      ["⌘⇧E", "Composer"],
      ["⌘⇧T", "Quick Terminal"],
      ["⌘⇧Z", "Reopen closed tab"],
      ["⌘,", "Settings"],
    ],
    keysFine: "⌘ on macOS; the equivalent primary modifier elsewhere.",
    endH: "Try the preview.",
    srcLabel: "or build it",
    docs: "Documentation",
  },
  zh: {
    title: "mtty — 用 Rust 编写的 AI 原生终端与编辑器",
    description:
      "mtty 是用 Rust 编写的 AI 原生终端与编辑器，本地与远程同样顺手：GPU 渲染的终端、远程主机、文件与你的 AI 编程代理，同在一个快速的原生窗口里。",
    kind: "终端 · 编辑器 · 代理",
    h1a: "AI 原生的终端与编辑器，",
    h1b: "本地与远程同样顺手。",
    lede: "终端、文件、远程主机和你的 AI 编程代理，放进同一个快速的原生窗口，共用同一套标签与分屏。用 Rust 编写，GPU 渲染，由性能门把关。不需要账号，不强制上云：mtty 托管你选择的代理，自己从不调用模型。",
    naming: "应用以 <code>mtty</code> 的名字发布（v0.0.5 及之前名为 <code>miaotty</code>），源码在 <code>miao-term</code> 仓库。",
    download: "下载预览版",
    build: "从源码构建",
    pkgs: [
      ["macOS", "Apple 芯片 · Intel"],
      ["Linux", ".deb · AppImage · tar"],
      ["Windows", "MSI · zip"],
    ],
    shot: "mtty 打开了三个会话标签和一个会话侧栏，活动窗格里是一份带颜色的 git 日志。",
    cap: "三个会话标签、会话侧栏，以及仓库自己的 git 日志",
    preview: "<strong>预发布。</strong>API 尚未稳定。macOS 是主要平台；Windows 与 Linux 已构建、测试，并在真实桌面上验收。Apple 公证与 Windows MSI 签名尚未完成。",
    pillarsLabel: "三根支柱",
    pillarsH: "终端、编辑器与代理，同在一个窗口。",
    pillarsToday: "现在",
    pillarsNext: "接下来",
    pillars: [
      ["终端与远程", "吸收 Termius 与 PuTTY", "GPU 渲染的终端、标签与分屏、会话恢复。主机库、密钥、SFTP 与 FTP、端口转发、跳板机、命令片段与广播输入，经由你自己的 OpenSSH。", "串口、Telnet 与原始 TCP 会话，.ppk 密钥；正在评估 Rust 原生的 SSH 实现。"],
      ["编辑器", "一流的编辑器，而非附属功能", "内置查看与编辑，带 Markdown 与 Mermaid 预览。编辑内核——rope 缓冲区、多光标、撤销、搜索——已完成，并在 100 MB 文件上设有性能门。", "与终端并列的编辑器窗格：tree-sitter 高亮、LSP，大文件也全速。"],
      ["代理工作台", "吸收 Superset，AI 原生", "来自 Claude Code、Codex、OpenCode 与 miao 的状态；需要你时的徽章与通知；提示队列；每个任务一个 git worktree 并审阅 diff；可脚本化的控制面。", "代理的修改以可撤销的 diff 在行内审阅、ACP 客户端，一步把选区、诊断或终端输出交给代理。"],
    ],
    engineLabel: "引擎优先",
    engineH: "引擎与应用，刻意分开。",
    engineBody: "依赖只向内指：宿主 → 渲染 → 内核。内核不含任何窗口或 GPU 代码，因此可以嵌入别的程序。应用是引擎的第一个使用者，而不是它的主人。",
    hot: "热路径不加锁，每帧零分配。",
    layers: [
      ["host", "miao-term-widget", "winit + wgpu 渲染循环，在同一帧合成 egui 界面"],
      ["render", "miao-term-render", "wgpu + glyphon 字形网格，四边形与图像管线"],
      ["core", "miao-term-core", "PTY、VT 解析、网格与回滚、选择、搜索、OSC、输入编码"],
    ],
    beside: ["graphics", "config", "mtp", "ui"],
    besideLabel: "并列模块",
    perfLabel: "实测",
    perfH: "性能预算，由 CI 把关。",
    perfBody: "每项指标都有留足余量的绝对预算：数量级的退化会让构建失败，运行器抖动不会。",
    perfHead: ["指标", "预算", "基线"],
    perf: [
      ["VT 解析吞吐", "≥ 25 MB/s", "73 MB/s"],
      ["屏幕快照，30 行", "≤ 2 ms", "0.012 ms"],
      ["每帧行构建", "≤ 4 ms", "0.12 ms"],
      ["命令面板排序，1 万条", "≤ 100 ms", "2.0 ms"],
    ],
    perfFine: "基线为 M 系列 Mac 上的 release 构建。帧时间与按键到字形的延迟需要真实窗口和 GPU，因此手动测量，不作为 CI 门槛。",
    wsLabel: "工作台",
    wsH: "不只是一个带提示符的窗口。",
    ws: [
      ["标签与分屏", "递归分屏树，分隔条可拖动。标签可以加标记、分组，重启后依然保留。", "⌘D  ⇧⌘D"],
      ["快速打开", "一个面板覆盖标签、代理、命令片段、主机、当前目录的文件、最近文件和命令。", "⌘K"],
      ["详情面板", "信息、代理、大纲、Git、文件、端口、队列，就在终端旁边。", "⌥⌘D"],
      ["阅读器与编辑器", "行号、可选的极简 vim 模式、用你自己的编辑器「在标签中编辑」，以及内置 Mermaid 子集的 CommonMark 渲染。", "⌘-打开"],
      ["内联图像", "Sixel、Kitty、iTerm2 图像直接画进网格，随内容滚动、按窗格裁剪。", "默认开启"],
      ["真正的终端行为", "基于 alacritty_terminal 的 VT、CJK 排版与系统字体回退、带高亮的查找、kitty 键盘协议。", "⌘F"],
      ["沿用你的配置", "首次运行自动导入 ghostty 和 alacritty 的设置。zsh 集成经由 ZDOTDIR 垫片完成，绝不修改你的 dotfiles。", "config.toml"],
      ["通过 ssh 编辑远程文件", "借助窗格的 ssh ControlMaster 连接查看和编辑远程文件，terminfo 零安装引导。", "ssh"],
    ],
    agentLabel: "为代理而造",
    agentH: "它知道每个窗格里的代理在做什么。",
    agentBody: "代理上报 idle、processing、awaiting 或 error 四种状态。mtty 把它变成标签上的徽章、代理需要你时的系统通知、代理工作时的防休眠，以及在窗格空闲后自动发送下一条消息的提示队列。",
    agentPoints: [
      ["miao", "通过内置集成上报状态，无需任何配置。"],
      ["其他代理 CLI", "mtty 能识别它们，安装状态钩子脚本，并复制好需要你自己添加的配置片段。绝不替你改动代理的配置。"],
      ["Composer", "多行提示编辑器，发送到当前窗格。", "⌘⇧E"],
    ],
    mtpLabel: "可脚本化",
    mtpH: "一个其他程序也能驱动的控制面。",
    mtpBody: "MTP 通过仅属主可访问的每用户套接字（Windows 上为命名管道）收发按行分隔的 JSON。每个响应都带状态版本号；客户端可以阻塞等待它变化，或订阅事件流，而不必轮询。",
    mtpFine: "通过 TCP 提供服务必须设置令牌，还可以用能力白名单限制可接受的请求。控制面会在你的 shell 中执行命令，请妥善保管令牌。",
    keysLabel: "键盘",
    keysH: "快捷键",
    keys: [
      ["⌘T", "新标签"],
      ["⌘D / ⇧⌘D", "向右 / 向下分屏"],
      ["⌘K", "快速打开"],
      ["⌘F", "查找"],
      ["⌥⌘D", "详情面板"],
      ["⌘⇧E", "Composer"],
      ["⌘⇧T", "Quick Terminal"],
      ["⌘⇧Z", "重新打开关闭的标签"],
      ["⌘,", "设置"],
    ],
    keysFine: "macOS 上为 ⌘，其他平台使用对应的主修饰键。",
    endH: "试试预览版。",
    srcLabel: "或者自己构建",
    docs: "文档",
  },
}[lang]
---

<MarketingLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="lattice" aria-hidden="true"></div>
    <div class="glow g1" aria-hidden="true"></div>
    <div class="wrap">
      <p class="label mtty rise"><MttyMark size={18} /><b>mtty</b> {copy.kind}</p>
      <h1 class="display h1 rise" style="--i:1">
        <span class="hl">{copy.h1a}</span>
        <em class="hl accent mtty">{copy.h1b}</em>
      </h1>
    </div>
    <div class="wrap hero-grid rise" style="--i:2">
      <div>
        <p class="lede">{copy.lede}</p>
        <p class="fine naming" set:html={copy.naming} />
      </div>
      <div class="hero-side">
        <div class="actions">
          <a class="btn solid" href={RELEASES}>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M8 2v8.5M4.5 7 8 10.5 11.5 7M3 13.5h10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            {copy.download}
          </a>
          <a class="btn" href={REPO}>{copy.build} <span class="arrow">↗</span></a>
        </div>
        <ul class="pkgs">
          {
            copy.pkgs.map(([os, formats]) => (
              <li>
                <b>{os}</b>
                <span>{formats}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="wrap">
      <figure class="shot hero-shot rise" style="--i:4">
        <img src="/shots/mtty.png" width="1971" height="950" alt={copy.shot} fetchpriority="high" />
        <figcaption>{copy.cap}</figcaption>
      </figure>
      <div class="callout preview">
        <span class="pip" aria-hidden="true"></span>
        <p set:html={copy.preview} />
      </div>
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>00</b> {copy.pillarsLabel}</p>
      <h2 class="display h2">{copy.pillarsH}</h2>
    </div>
    <ul class="ws pillars">
      {
        copy.pillars.map(([head, from, today, next]) => (
          <li>
            <div class="ws-top">
              <h3>{head}</h3>
              <kbd>{from}</kbd>
            </div>
            <p><strong>{copy.pillarsToday}.</strong> {today}</p>
            <p><strong>{copy.pillarsNext}.</strong> {next}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section engine" data-reveal>
    <div class="engine-copy">
      <p class="label"><b>01</b> {copy.engineLabel}</p>
      <h2 class="display h2">{copy.engineH}</h2>
      <p class="lede">{copy.engineBody}</p>
      <p class="hot">
        <span class="path" aria-hidden="true"
          ><span>pty</span><i>→</i><span>vt</span><i>→</i><span>grid</span><i>→</i><span
            >renderer</span
          ></span
        >
        {copy.hot}
      </p>
    </div>
    <div class="stack">
      {
        copy.layers.map(([tier, crate, role]) => (
          <div class="layer" data-tier={tier}>
            <span class="tier">{tier}</span>
            <code class="crate">{crate}</code>
            <span class="role">{role}</span>
          </div>
        ))
      }
      <div class="beside">
        <span class="tier">{copy.besideLabel}</span>
        {copy.beside.map((name) => <code>miao-term-{name}</code>)}
      </div>
    </div>
  </section>

  <section class="wrap section perf" data-reveal>
    <div class="section-head">
      <p class="label"><b>02</b> {copy.perfLabel}</p>
      <h2 class="display h2">{copy.perfH}</h2>
      <p class="lede">{copy.perfBody}</p>
    </div>
    <div class="meters">
      {
        copy.perf.map(([metric, budget, baseline]) => (
          <div class="meter">
            <p class="metric">{metric}</p>
            <p class="baseline">{baseline}</p>
            <p class="budget">
              <span>{copy.perfHead[1]}</span> {budget}
            </p>
          </div>
        ))
      }
    </div>
    <p class="fine note">{copy.perfFine}</p>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <p class="label"><b>03</b> {copy.wsLabel}</p>
      <h2 class="display h2">{copy.wsH}</h2>
    </div>
    <ul class="ws">
      {
        copy.ws.map(([head, body, hint]) => (
          <li>
            <div class="ws-top">
              <h3>{head}</h3>
              <kbd>{hint}</kbd>
            </div>
            <p>{body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section agents" data-reveal>
    <div class="agents-copy">
      <p class="label"><b>04</b> {copy.agentLabel}</p>
      <h2 class="display h2">{copy.agentH}</h2>
      <p class="lede">{copy.agentBody}</p>
    </div>
    <div class="agents-side">
      <div class="statebar" aria-hidden="true">
        <span data-state="idle">idle</span>
        <span data-state="processing">processing</span>
        <span data-state="awaiting">awaiting</span>
        <span data-state="error">error</span>
      </div>
      <dl class="agent-points">
        {
          copy.agentPoints.map(([term, detail, key]) => (
            <div>
              <dt>
                {term} {key && <kbd>{key}</kbd>}
              </dt>
              <dd>{detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap section mtp" data-reveal>
    <div>
      <p class="label"><b>05</b> {copy.mtpLabel}</p>
      <h2 class="display h2">{copy.mtpH}</h2>
      <p class="lede">{copy.mtpBody}</p>
      <p class="fine">{copy.mtpFine}</p>
    </div>
    <pre class="codeblock mtty"><code><span class="p">$ </span>mtty-cli pane list
<span class="p">$ </span>mtty-cli pane run --pane ID --data "cargo test"
<span class="p">$ </span>mtty-cli events --topic agent.state
<span class="p">$ </span>mtty-cli wait --since 42
<span class="p">$ </span>mtty-cli view ./README.md
<span class="p">$ </span>mtty-cli file read --path /etc/hosts   <span class="c"># ≤ 2 MB</span></code></pre>
  </section>

  <section class="wrap section keys" data-reveal>
    <div class="section-head">
      <p class="label"><b>06</b> {copy.keysLabel}</p>
      <h2 class="display h3">{copy.keysH}</h2>
    </div>
    <dl class="keygrid">
      {
        copy.keys.map(([key, action]) => (
          <div>
            <dt><kbd>{key}</kbd></dt>
            <dd>{action}</dd>
          </div>
        ))
      }
    </dl>
    <p class="fine note">{copy.keysFine}</p>
  </section>

  <section class="wrap section end" data-reveal>
    <MttyMark size={44} />
    <h2 class="display h2">{copy.endH}</h2>
    <div class="actions">
      <a class="btn solid" href={RELEASES}>{copy.download} <span class="arrow">→</span></a>
