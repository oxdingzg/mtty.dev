    screens: [
      ["/shots/miao-session.mp4", "审阅改动，选择模型", "示例代码审阅会话中直接查看 diff 和上下文遥测；打开模型选择，无需离开当前会话。"],
      ["/shots/miao-providers.mp4", "自带模型服务商", "打开供应商选择器，浏览可用服务；连接 OpenAI、Anthropic、GitHub Copilot、Google 或自己的端点。"],
      ["/shots/miao-web.mp4", "同一个会话，也能在浏览器里看", "在 miao 浏览器界面展开编辑 diff、打开文件审阅面板；与终端截图使用同一个示例会话。"],
      ["/shots/miao-mini.mp4", "紧凑的交互模式", "开发构建中可选的 mini 界面：任务进度、编辑 diff 和多选问题，使用内置演示模式录制。"],
      ["/shots/miao-permission.webp", "允许编辑前，先看清改动", "mini 界面的编辑权限确认展示拟议 diff，以及单次允许、始终允许和拒绝选项。来自内置演示模式。"],
      ["/shots/miao-home.webp", "从一个提示开始", "当前终端启动界面，输入框旁直接显示所选代理、模型和推理档位。"],
    ],
    loopLabel: "长任务，有边界",
    loopH: "让它继续推进 —— 在预算之内。",
    loopBody: "自治续跑需要手动开启。只要还有未完成的待办，它就继续，并受迭代上限和停滞检测保护。会话估算费用达到阈值后，费用预算会停止调度新的模型轮次。",
    loopFine: "预算不是供应商账单的硬上限，也不会中止已经发出的那一轮。项目级配置放在 .miao/miao.jsonc，全局配置放在 ~/.config/miao/miao.jsonc。",
    sandboxLabel: "隔离",
    sandboxH: "它为要执行的命令提供内核级沙箱。",
    sandboxBody: "miao 的 Rust 层刻意做得很小，只覆盖其余部分做不到的两件事：围绕 bash 的内核级隔离，以及 edit 与 apply_patch 背后的匹配与补丁路径。",
    sandboxRows: [
      [
        "内核级隔离",
        "macOS seatbelt 与 Linux Landlock 拒绝写入当前 Location、命令自身目录以及你批准的路径之外的位置。",
      ],
      [
        "以批准代替失败",
        "被拦下的写入会报告它需要的路径并就此停下 —— 批准该目录，命令便带着它重跑。",
      ],
      [
        "出厂即启用，也留了退路",
        "正常安装下，原生编辑匹配与补丁派生经由 addon 运行；MIAO_NATIVE=0 可关闭，改由 TypeScript 实现接管。",
      ],
    ],
    sandboxFine: "沙箱需手动开启，默认关闭，且 Windows 尚无后端。它默认 fail-open：请求了沙箱却没有后端时会告警并裸跑命令，除非把 on_unavailable 设为 \"fail\"。",
    statusLabel: "现状",
    statusH: "1.0 之前，哪些能用说清楚。",
    statusHead: ["能力", "可用性"],
    status: [
      ["持久化会话、输入接收、Context Epoch、项目内会话消息", "已实现", "ok"],
      ["自治续跑、费用预算、输出裁剪与压缩调优", "可选开启", "opt"],
      ["Code Mode", "实验性", ""],
      ["bash 的内核级沙箱；edit 与 apply_patch 的原生加速", "沙箱需开启 · 加速默认启用", "opt"],
      ["生成的客户端与嵌入式宿主", "API 仍在演进", ""],
    ],
    startLabel: "快速开始",
    startH: "三条命令，开始第一个会话。",
    startFine: "在 TUI 内用 <kbd>ctrl+p</kbd> 打开命令面板，用 <kbd>ctrl+x m</kbd> 选择模型。<code>miao models</code> 可以列出可用模型。",
    c1: "选择供应商，连接账户或 API Key",
    c2: "启动终端界面",
    c3: "一次性执行，不进 TUI",
    c4: "打开浏览器界面",
    c5: "更新正式版",
