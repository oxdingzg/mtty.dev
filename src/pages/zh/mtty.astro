---
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import MttyMark from "../../components/site/MttyMark.astro"

const features = [
  {
    title: "可以嵌入的引擎",
    body: "miao-term-core 掌管从 PTY 到屏幕的热路径，不依赖任何窗口或 GPU 代码，因此能直接放进另一个应用。",
  },
  {
    title: "GPU 字形网格渲染",
    body: "wgpu 配合 glyphon，与 egui 共用 device、queue 和 surface。界面外壳与终端在同一帧内合成。",
  },
  {
    title: "标签页、分屏与侧栏",
    body: "递归分屏树、可拖拽的分隔条、文件树，以及把窗格的 cwd、命令或代理映射为别名、图标与徽章的视图规则。",
  },
  {
    title: "Shell 集成与控制面",
    body: "一套可脚本化的控制面，其他程序可以向它上报 —— 代理状态正是这样抵达窗格徽章的。",
  },
  {
    title: "真正的终端行为",
    body: "基于 alacritty_terminal 的 VT 解析、带选区的回滚与复制粘贴、宽字符与中日韩排版、带高亮的查找，以及 kitty 键盘协议。",
  },
  {
    title: "跨平台",
    body: "macOS 是主要平台。Windows 在真实硬件上构建并实际使用；Linux 在 CI 中构建并通过测试。",
  },
]
---

<MarketingLayout
  lang="zh"
  title="mtty — 用 Rust 编写的快速可嵌入终端模拟器"
  description="mtty 是用 Rust 编写的快速、可嵌入、跨平台终端模拟器与引擎，使用 wgpu 在 GPU 上渲染。"
>
  <section class="hero">
    <div class="hero-glow cool" aria-hidden="true"></div>
    <div class="title">
      <MttyMark size={44} />
      <h1>mtty</h1>
    </div>
    <p class="tagline warm">用 Rust 编写的快速、可嵌入、跨平台终端模拟器与引擎。</p>
    <p class="lede">
      一个不含窗口与 GPU 代码的终端引擎，以及构建其上的完整应用 ——
      标签页、分屏、侧栏、shell 集成与可脚本化的控制面。
    </p>
  </section>

  <section class="wrap" data-reveal>
    <figure class="shot">
      <img
        src="/shots/mtty.png"
        width="1971"
        height="950"
        alt="mtty 打开了三个会话标签和一个会话侧栏，活动窗格里是一份带颜色的 git 日志。"
      />
      <figcaption>mtty，展示自己的提交历史。</figcaption>
    </figure>
  </section>

  <section class="wrap">
    <div class="preview">
      <strong>开发预览。</strong> mtty 尚未发布稳定版。当前版本 0.0.4，API 仍在变动。
      请从源码构建，并预期会有粗糙之处。
    </div>
    <p class="note">构建说明在仓库中，与架构文档放在一起。</p>
  </section>

  <section class="wrap">
    <h2>它是什么</h2>
    <ul class="features">
      {
        features.map((feature) => (
          <li>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap cta">
    <a class="button" href="https://github.com/oxdingzg/miao-term">从源码构建</a>
    <a class="link" href="/zh/docs/mtty/">文档</a>
  </section>
</MarketingLayout>
