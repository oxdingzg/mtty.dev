---
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import MiaoMark from "../../components/site/MiaoMark.astro"
import MttyMark from "../../components/site/MttyMark.astro"

const products = [
  {
    href: "/zh/miao",
    name: "miao",
    kind: "AI 编程代理",
    blurb:
      "探索代码仓库、编辑代码、执行命令并自查结果 —— 用你自己选的模型，花费一目了然。",
    meta: "TypeScript · MIT",
    Mark: MiaoMark,
  },
  {
    href: "/zh/mtty",
    name: "mtty",
    kind: "终端模拟器",
    blurb:
      "用 Rust 编写的快速、可嵌入的终端模拟器与引擎。GPU 渲染、跨平台，专为在窗格中运行代理而设计。",
    meta: "Rust · Apache-2.0 · 开发预览",
    Mark: MttyMark,
  },
]
---

<MarketingLayout
  lang="zh"
  title="mtty.dev — miao 与 mtty"
  description="miao 是面向终端的开源 AI 编程代理。mtty 是用 Rust 编写的快速、可嵌入的终端模拟器与引擎。"
>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <p class="eyebrow">开源 · MIT &amp; Apache-2.0</p>
    <h1>为终端而生的两个工具。</h1>
    <p class="lede">
      一个替你干活的代理，一个为运行它而造的终端。二者相互独立 ——
      可以单独使用任意一个，也可以让它们互相通信。
    </p>
    <div class="cta">
      <a class="button" href="/zh/docs/">阅读文档</a>
      <code class="install">curl -fsSL https://mtty.dev/miao/install | bash</code>
    </div>
  </section>

  <section class="wrap" data-reveal>
    <figure class="shot">
      <img
        src="/shots/mtty.png"
        width="1971"
        height="950"
        alt="mtty 打开了三个会话标签和一个会话侧栏，活动窗格里是一份带颜色的 git 日志。"
      />
      <figcaption>mtty，展示自己的提交历史。</figcaption>
    </figure>
  </section>

  <section class="wrap" data-reveal>
    <ul class="cards">
      {
        products.map(({ href, name, kind, blurb, meta, Mark }) => (
          <li>
            <a href={href}>
              <Mark size={36} />
              <span class="kind">{kind}</span>
              <span class="name">{name}</span>
              <span class="blurb">{blurb}</span>
              <span class="meta">{meta}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap together" data-reveal>
    <div>
      <h2>配合更好，但互不依赖</h2>
      <p>
        mtty 给每个窗格一个身份，miao 上报自己正在做什么 —— 空闲、处理中、等待你输入，
        还是失败。终端据此为窗格加上徽章并弹出通知，让你能同时盯住多个代理，
        不必逐个窗口去读。终端从不依赖代理：没有任务上报时，它就只是一个终端。
      </p>
    </div>
    <div class="pair" aria-hidden="true">
      <div class="pair-line">
        <MiaoMark size={38} />
        <span class="wire"></span>
        <MttyMark size={38} />
      </div>
      <div class="states">
        <span>idle</span>
        <span>processing</span>
        <span>awaiting</span>
        <span>error</span>
      </div>
    </div>
  </section>
</MarketingLayout>
