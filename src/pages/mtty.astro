---
import MarketingLayout from "../layouts/MarketingLayout.astro"
import MttyMark from "../components/site/MttyMark.astro"

const features = [
  {
    title: "An engine you can embed",
    body: "miao-term-core owns the hot path from the PTY to the screen and depends on no windowing or GPU code, so it drops into another application.",
  },
  {
    title: "GPU glyph-grid rendering",
    body: "wgpu with glyphon, sharing egui's device, queue and surface. Chrome composites in the same frame as the terminal.",
  },
  {
    title: "Tabs, splits and side panels",
    body: "A recursive split tree, draggable dividers, a file tree, and view rules that map a pane's cwd, command or agent to an alias, icon and badge.",
  },
  {
    title: "Shell integration and a control plane",
    body: "A scriptable control plane other programs can report into — which is how an agent's state reaches the pane badge.",
  },
  {
    title: "Real terminal behaviour",
    body: "VT parsing via alacritty_terminal, scrollback with selection and copy/paste, wide-character and CJK layout, find with match highlighting, and the kitty keyboard protocol.",
  },
  {
    title: "Cross-platform",
    body: "macOS is the primary platform. Windows is built and driven on real hardware; Linux builds and passes tests in CI.",
  },
]
---

<MarketingLayout
  title="mtty — a fast, embeddable terminal emulator in Rust"
  description="mtty is a fast, embeddable, cross-platform terminal emulator and engine written in Rust, rendered on the GPU with wgpu."
>
  <section class="hero">
    <div class="hero-glow cool" aria-hidden="true"></div>
    <div class="title">
      <MttyMark size={44} />
      <h1>mtty</h1>
    </div>
    <p class="tagline warm">A fast, embeddable, cross-platform terminal emulator and engine, written in Rust.</p>
    <p class="lede">
      A terminal engine with no windowing or GPU code in it, and a full application built
      on top — tabs, splits, side panels, shell integration and a scriptable control
      plane.
    </p>
  </section>

  <section class="wrap" data-reveal>
    <figure class="shot">
      <img
        src="/shots/mtty.png"
        width="1971"
        height="950"
        alt="mtty with three session tabs, a session sidebar, and a coloured git log in the active pane."
      />
      <figcaption>mtty, showing its own git history.</figcaption>
    </figure>
  </section>

  <section class="wrap">
    <div class="preview">
      <strong>Development preview.</strong> mtty has not had a stable release. The version is
      0.0.4 and the API is still moving. Build it from source and expect rough edges.
    </div>
    <p class="note">
      Build instructions live in the repository, alongside the architecture notes.
    </p>
  </section>

  <section class="wrap">
    <h2>What it is</h2>
    <ul class="features">
      {
        features.map((feature) => (
          <li>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap cta">
    <a class="button" href="https://github.com/oxdingzg/miao-term">Build from source</a>
    <a class="link" href="/docs/mtty/">Documentation</a>
  </section>
</MarketingLayout>
