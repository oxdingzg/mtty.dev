---
import MarketingLayout from "../layouts/MarketingLayout.astro"
import MiaoMark from "../components/site/MiaoMark.astro"
import MttyMark from "../components/site/MttyMark.astro"

const products = [
  {
    href: "/miao",
    name: "miao",
    kind: "AI coding agent",
    blurb:
      "Explores a repository, edits code, runs commands and checks its own work — with the models you choose and a clear view of what they cost.",
    meta: "TypeScript · MIT",
    Mark: MiaoMark,
  },
  {
    href: "/mtty",
    name: "mtty",
    kind: "Terminal emulator",
    blurb:
      "A fast, embeddable terminal emulator and engine written in Rust. GPU-rendered, cross-platform, and built to host an agent inside a pane.",
    meta: "Rust · Apache-2.0 · development preview",
    Mark: MttyMark,
  },
]
---

<MarketingLayout
  title="mtty.dev — miao and mtty"
  description="miao is an open-source AI coding agent for the terminal. mtty is a fast, embeddable terminal emulator and engine written in Rust."
>
  <section class="hero wrap">
    <h1>Two tools for the terminal.</h1>
    <p class="lede">
      An agent that does the work, and a terminal built to run it. They are independent
      projects — use either on its own, or let them talk to each other.
    </p>
  </section>

  <section class="wrap">
    <ul class="cards">
      {
        products.map(({ href, name, kind, blurb, meta, Mark }) => (
          <li>
            <a href={href}>
              <Mark size={36} />
              <span class="kind">{kind}</span>
              <span class="name">{name}</span>
              <span class="blurb">{blurb}</span>
              <span class="meta">{meta}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap together">
    <h2>Better together, not dependent</h2>
    <p>
      mtty gives every pane an identity, and miao reports what it is doing — idle,
      processing, waiting on you, or failed. The terminal badges the pane and raises a
      notification, so you can watch several agents at once without reading every
      window. The terminal never needs the agent: with nothing reporting in, it is
      simply a terminal.
    </p>
  </section>
</MarketingLayout>
