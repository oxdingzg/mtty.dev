{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtty-dev",
  "compatibility_date": "2026-10-01",
  // The site is fully static: there is no Worker script, only assets. Astro
  // writes dist/404.html, so unmatched paths get the site's own 404 page rather
  // than Cloudflare's default.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "mtty.dev",
      "custom_domain": true
    }
  ]
}
